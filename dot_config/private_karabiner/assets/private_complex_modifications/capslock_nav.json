{
  "title": "Caps Lock: Tap = Esc, Hold = Vim/Extended Navigation",
  "rules": [
    {
      "description": "Caps Lock: hold sets capslock_mode variable, tap alone sends Escape",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "capslock_mode",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "capslock_mode",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 9610,
                  "product_id": 268
                },
                {
                  "vendor_id": 13652,
                  "product_id": 64009
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Caps Lock + h/j/k/l = Arrow keys",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "capslock_mode",
              "value": 1
            },
            {
              "type": "device_if",
              "identifiers": [
