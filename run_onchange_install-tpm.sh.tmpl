{{ $tmuxConfHash := include "dot_config/tmux/tmux.conf" | sha256sum -}}
#!/usr/bin/env bash
# tmux.conf hash: {{ $tmuxConfHash }}
set -euo pipefail

TPM="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm"

if [[ ! -d "$TPM/.git" ]]; then
    git clone https://github.com/tmux-plugins/tpm "$TPM"
fi

"$TPM/bin/install_plugins"
